{
  "name": "cenitu-table",
  "version": "0.4.0-beta.2",
  "description": "Spreadsheet-like data grid with a built-in multi-sheet formula engine. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Cenitu (https://github.com/cenitu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cenitu/cenitu-table.git"
  },
  "homepage": "https://github.com/cenitu/cenitu-table#readme",
  "bugs": {
    "url": "https://github.com/cenitu/cenitu-table/issues"
  },
  "main": "./dist/cenitu-table.cjs",
  "module": "./dist/cenitu-table.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cenitu-table.js",
      "require": "./dist/cenitu-table.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./formula": {
      "types": "./dist/types/formula/index.d.ts",
      "import": "./dist/formula.js",
      "require": "./dist/formula.cjs"
    },
    "./export": {
      "types": "./dist/types/export/index.d.ts",
      "import": "./dist/export.js",
      "require": "./dist/export.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "spreadsheet",
    "data-grid",
    "datagrid",
    "formula",
    "excel",
    "table",
    "virtual-scroll",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "npm run build && npm run build:demo && npm run check:dist && npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.44"
  },
  "types": "./dist/types/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
